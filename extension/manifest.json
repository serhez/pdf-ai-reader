{
  "manifest_version": 3,
  "name": "Project PDF Reader",
  "version": "0.3.0",
  "description": "Highlight selected local-document text in Markdown or explain it with project context.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "file:///*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Project PDF Reader"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
